# 在 https://aistudio.google.com/apikey 免费获取，不填则使用规则算法组队
GEMINI_API_KEY=
# 可选：指定 Gemini 模型
GEMINI_MODEL=gemini-flash-latest
# 可选：上线时换成 Turso 云数据库，例如 libsql://xxx.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# 可选：翻译用的模型（调用量大，默认用轻量模型，免费额度与主模型分开计算）
GEMINI_TRANSLATE_MODEL=gemini-flash-lite-latest

# 可选：发邮件（找回密码）用的 SMTP。Gmail 需开启两步验证后生成“应用专用密码”
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 可选：网站正式地址，用于邮件里的链接，如 https://study-buddy.example.com
APP_URL=
