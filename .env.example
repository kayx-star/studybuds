# Free at https://aistudio.google.com/apikey — without it the app uses rule-based matching only
GEMINI_API_KEY=
# Optional: Gemini model (each model has its own free-tier quota)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: used when the main model is overloaded or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: switch to a Turso cloud database in production, e.g. libsql://xxx.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Optional: model for translations (high volume, so a lighter model with its own quota)
GEMINI_TRANSLATE_MODEL=gemini-flash-lite-latest

# Optional: SMTP for password-reset emails (for Gmail, enable 2-Step Verification and create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: public site URL used in email links, e.g. https://studybuds.tech
APP_URL=https://studybuds.tech
